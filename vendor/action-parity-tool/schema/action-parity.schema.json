{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dongsheng123132/action-parity/v0.1.0/schema/action-parity.schema.json",
  "title": "ActionParity Manifest",
  "description": "Manifest for ActionParity 0.1.0 working draft.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "application",
    "surfaces",
    "actions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "spec_version": {
      "const": "0.5.0"
    },
    "application": {
      "$ref": "#/$defs/application"
    },
    "conformance_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "AP-1",
          "AP-2",
          "AP-3",
          "AP-4"
        ]
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator"
      ],
      "properties": {
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        }
      },
      "description": "Where this manifest was generated from. Never treated as verified: a validator cannot re-run a generator it does not have."
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "homepage": {
          "type": "string",
          "pattern": "^https://"
        },
        "source": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "required_for_parity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "gui",
            "tui",
            "cli",
            "mcp",
            "api",
            "ipc",
            "test"
          ]
        },
        "required_for_parity": {
          "type": "boolean"
        },
        "test_driver": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "reachability": {
          "enum": [
            "in-process",
            "local-ipc",
            "external"
          ],
          "description": "Who can invoke this Surface. Absent means in-process for ipc and test, and the honest default for the kind otherwise. A Surface only its own application can reach is not machine access."
        },
        "exclusion_reason": {
          "type": "string",
          "minLength": 8,
          "description": "Why this machine Surface is not required for parity. Demoting a Surface shrinks the parity denominator, so the reason must be stated rather than implied."
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "input_schema",
        "output_schema",
        "effects",
        "execution",
        "bindings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "input_schema": {
          "type": "object"
        },
        "output_schema": {
          "type": "object"
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "parity_exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parityException"
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "risk",
        "reversible",
        "confirmation",
        "audit_required"
      ],
      "properties": {
        "class": {
          "enum": [
            "read",
            "write",
            "external",
            "financial",
            "destructive"
          ]
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "reversible": {
          "type": "boolean"
        },
        "confirmation": {
          "enum": [
            "never",
            "conditional",
            "always"
          ]
        },
        "audit_required": {
          "type": "boolean"
        },
        "rollback_action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headless",
        "idempotent",
        "cancellable",
        "timeout_ms"
      ],
      "properties": {
        "headless": {
          "type": "boolean"
        },
        "idempotent": {
          "type": "boolean"
        },
        "cancellable": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "progress_events": {
          "type": "boolean"
        },
        "headless_evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Path or command that demonstrates headless execution. headless:true without this is a claim, not evidence."
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "target"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "test": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parityException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "reason",
        "owner",
        "review_by"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "reason": {
          "type": "string",
          "minLength": 8
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "review_by": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
          }
        },
        "events": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
          }
        },
        "external_resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalResource"
          },
          "description": "Truth sources outside this application that its Actions read or write. Shared configuration is where cross-product drift actually happens."
        }
      }
    },
    "externalResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "access",
        "exclusive"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Location of the shared truth, as a path, URI, or registry key."
        },
        "access": {
          "enum": [
            "read",
            "write",
            "read-write"
          ]
        },
        "exclusive": {
          "type": "boolean",
          "description": "True only when this application is the sole writer. False means another product can write the same resource."
        },
        "concurrency": {
          "enum": [
            "last-writer-wins",
            "optimistic",
            "advisory-lock",
            "exclusive-lock"
          ],
          "description": "How a concurrent write from another writer is handled. Required when the resource is shared and written."
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
